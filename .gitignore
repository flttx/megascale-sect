node_modules/
dist/
artifacts/
*.tsbuildinfo
.env
.env.*
.omc/*
!.omc/skills/
# Tripo raw downloads (~15 MB each) are reproducible from manifest.lock.json task ids.
asset-pipeline/tripo/*/raw.glb
asset-pipeline/tripo/*/v1/
# Rebuild pipelines: raw Tripo/Blender intermediates are large and reproducible.
asset-pipeline/*/*/raw/
asset-pipeline/*/raw/
asset-pipeline/*/*/work/
asset-pipeline/*/textures/
asset-pipeline/**/*.blend
asset-pipeline/**/*.blend1
# The full Blender scene is rebuilt from environment-pipeline sources.
environment-pipeline/T02R-environment.blend*
# Rebuild pipeline scratch: previews, caches, raw meshes and logs are reproducible from the scripts and task locks.
asset-pipeline/*/tmp/
asset-pipeline/*/out/
asset-pipeline/*/cache/
asset-pipeline/**/__pycache__/
asset-pipeline/**/*.log
asset-pipeline/**/*.npz
asset-pipeline/anim/**/*.glb
asset-pipeline/kun/*.glb
asset-pipeline/kun/*.png
