{
  "name": "megascale-sect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify:smoke": "node scripts/smoke.mjs",
    "verify:navigation": "node scripts/navigation.mjs",
    "verify:characters": "node scripts/characters.mjs",
    "verify:optimization": "node scripts/verify-optimization.mjs",
    "verify:riding-pose": "node scripts/verify-riding-pose.mjs",
    "verify:interact": "node scripts/verify-interact.mjs",
    "verify:perf": "node scripts/verify-perf.mjs",
    "verify:visual": "node scripts/verify-visual.mjs",
    "verify:controls": "node scripts/verify-controls.mjs",
    "verify:save": "node scripts/verify-save.mjs",
    "verify:motion": "node scripts/verify-motion.mjs",
    "verify:kun": "node scripts/verify-kun.mjs",
    "verify:stability": "node scripts/verify-stability.mjs",
    "assets:optimize": "node scripts/optimize-characters.mjs",
    "assets:buildings": "node scripts/optimize-buildings.mjs && node asset-pipeline/buildings/meta.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@react-three/postprocessing": "^3.1.2",
